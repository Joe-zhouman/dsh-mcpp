{
  "name": "dsh-mcpp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "static"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
    "build": "node ../../node_modules/tsdown/dist/run.mjs --config tsdown.config.mjs --config-loader native",
    "test": "node --test --experimental-strip-types test/*.test.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json"
  }
}
